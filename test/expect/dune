(library
 (name central_test)
 (package central-tests)
 (inline_tests
  (deps central.exe))
 (flags
  :standard
  -w
  +a-4-40-41-42-44-45-48-66
  -warn-error
  +a
  -open
  Central_stdlib
  -open
  Pplumbing_err
  -open
  Volgo
  -open
  Central)
 (libraries
  central
  central_stdlib
  central_test_harness
  central_test_helpers
  pplumbing-err
  volgo
  volgo-git-unix)
 (instrumentation
  (backend bisect_ppx))
 (lint
  (pps ppx_js_style -allow-let-operators -check-doc-comments))
 (preprocess
  (pps ppx_expect)))

(rule
 (copy %{bin:central} central.exe))

(rule
 (enabled_if %{bin-available:mdexp})
 (target export.md.gen)
 (deps export.ml)
 (action
  (with-stdout-to
   %{target}
   (run mdexp pp %{deps}))))

(rule
 (enabled_if %{bin-available:mdexp})
 (alias runtest)
 (action
  (diff export.md export.md.gen)))

