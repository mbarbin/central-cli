license: "MIT"
homepage: "https://github.com/mbarbin/central-cli"
doc: "https://mbarbin.github.io/central-cli/"
bug-reports: "https://github.com/mbarbin/central-cli/issues"
depends: [
  "dune" {>= "3.20"}
  "ocaml" {>= "5.3"}
  "central" {= version}
  "file-rewriter" {>= "0.0.3"}
  "fpath" {>= "0.7.3"}
  "mdexp" {>= "0.0.20260814"}
  "pplumbing-err" {>= "0.0.16"}
  "ppx_expect" {>= "v0.17"}
